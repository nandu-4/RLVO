# ── Server-side (Vercel project env / `vercel dev`) ──
# Free key: https://aistudio.google.com/apikey
# Never prefixed with VITE_ — must not be visible to the browser.
GEMINI_API_KEY=your-gemini-api-key
# Optional model override. This value is reported back to the UI as `modelUsed`, so the label
# shown to users is always the model that actually ran (default: gemini-2.5-flash).
# GEMINI_MODEL=gemini-2.5-flash-lite

# ── OpenRouter (optional second provider) ──
# One gateway to Anthropic, OpenAI, Google and Alibaba models. Configure alongside Gemini and
# TruthLens will fall back to whichever is available if the other fails.
# OPENROUTER_API_KEY=sk-or-v1-...

# ── Hugging Face (third automatic vision-provider fallback) ──
# HUGGINGFACE_API_KEY=hf_...
# Default is Qwen/Qwen2.5-VL-72B-Instruct. The HF router returns 400 model_not_supported for
# Qwen2.5-VL-7B on accounts where no enabled provider serves it, so 72B is the verified default.
# HUGGINGFACE_MODEL=Qwen/Qwen2.5-VL-72B-Instruct
# OPENROUTER_MODEL=anthropic/claude-sonnet-4
# Optional attribution shown on your OpenRouter dashboard.
# OPENROUTER_SITE_URL=https://your-app.vercel.app

# Which provider to prefer when both are configured: "gemini" or "openrouter".
# Users can override this per browser from the Admin page.
# DEFAULT_PROVIDER=gemini

# Models the /benchmark page can run, comma separated. Each runs the identical production
# pipeline so the comparison is like-for-like.
# Do NOT add gemini-2.0-* on a free-tier key: it reports "limit: 0" and every row fails.
# BENCHMARK_MODELS=gemini-2.5-flash-lite,gemini-2.5-flash

# ── FREE TIER QUOTA WARNING ──
# gemini-2.5-flash allows only 20 requests/day on the free tier. Verification makes TWO model
# calls (transcribe + verify), so a free key sustains roughly 10 verifications/day. Self-check
# adds a third call; a 3-model benchmark costs 6. Set GEMINI_MODEL=gemini-2.5-flash-lite for
# development, and enable billing before any real use.

# ── Client-side (optional) ──
# AI backend: "api" (default, same-origin /api/*) or "python" (local FastAPI)
# VITE_BACKEND=python
# VITE_PYTHON_API=http://localhost:8000

# ── Authentication (Google via Supabase Auth) ──
# These two are PUBLIC by design and must be VITE_-prefixed so the browser can start a session.
# The anon key is publishable; the service-role key below must never be exposed.
# Enable the Google provider in Supabase → Authentication → Providers, and add your app origin
# to the allowed redirect URLs.
# VITE_SUPABASE_URL=https://your-project.supabase.co
# VITE_SUPABASE_ANON_KEY=your-anon-key

# ── Deterministic OCR (PaddleOCR) ──
# PaddleOCR is a Python library and cannot run inside Vercel's Node functions, so it is a separate
# service — see python/ocr_service.py and docs/DEPLOYMENT.md. Without this the pipeline falls back
# to model transcription and labels the run "model OCR" instead of "PaddleOCR".
# OCR_SERVICE_URL=https://your-ocr-service.example.com
# OCR_TIMEOUT_MS=30000
# OCR_LANG=en

# ── Session storage (local driver — the default; no setup required) ──
# Every verification is stored with its COMPLETE snapshot so it can be replayed later without
# spending an AI call, and so re-verifying the same document + claims is answered from storage.
# This is ON by default. Sessions are scoped to a browser-generated device id, which is a scoping
# key and NOT a credential — use Supabase below for anything shared or multi-user.
#
# Where sessions are written. Default: ./.truthlens-data
# On Vercel's managed runtime only /tmp is writable and it is per-instance and evicted freely,
# so set this to a real mounted volume if you need hosted durability — or configure Supabase.
# TRUTHLENS_DATA_DIR=/var/lib/truthlens
#
# Set to "off" for a genuinely stateless deployment.
# TRUTHLENS_LOCAL_STORE=off

# ── Persistence (server-side only; never prefix these with VITE_) ──
#
# UNSET -> Everyone stays in DEMO mode. Verification works, nothing is stored, and the dashboard,
#          review queue and audit trail explain why they are unavailable.
# SET   -> WORKSPACE mode for signed-in users. Data is scoped to the authenticated Supabase user
#          id; guests still get demo mode. Apply ALL files in supabase/migrations, in order.
#
# SECURITY: the service-role key bypasses RLS entirely. Keep it server-side only.
# share link. Whoever holds it has the workspace, there is no second factor, and it cannot be
# recovered. That is appropriate for open self-serve use and is NOT sufficient for regulated
# personal or health data — that needs real authentication, which this deployment does not have.
#
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Days a verified document is retained before it becomes eligible for purge. Each account can
# override this from Admin → Account.
# DEFAULT_RETENTION_DAYS=30

# ── Rate limiting ──
# Applied per signed-in user, or per client IP for guests.
# NOTE: the limiter is in-memory and therefore per function instance. It is a guardrail against
# one caller hammering a warm instance, NOT a billing control. Put a durable limiter (Upstash
# Redis) or an API gateway in front before exposing this publicly.
# VERIFY_RATE_LIMIT=10
# VERIFY_RATE_WINDOW_MS=60000
